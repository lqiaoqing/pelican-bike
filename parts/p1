/* =====================================================================
 *  滚动层工具
 *  - Tile：内容按固定周期重复（路面标线、护栏等），用 translate 取模
 *  - Loop：独立物体在周期内循环出现（棕榈、路牌、灯杆等）
 *  factor = 视差系数（1 = 与路面同速）
 * ===================================================================== */
const tiles = [], loops = [];
function Tile(parent, width, factor, drawFn, copies) {
  const grp = g(parent); const n = copies || Math.ceil(1800 / width) + 1;
  for (let i = 0; i < n; i++) drawFn(g(grp, { transform: `translate(${i * width},0)` }), i);
  const t = { g: grp, w: width, f: factor, drift: 0, x0: -100 };
  tiles.push(t); return t;
}
function Loop(parent, factor, period, margin) {
  const L = { g: g(parent), f: factor, period, margin: margin || 300, items: [] };
  L.add = (x, build, onWrap) => { const it = { x, g: g(L.g), cycle: -1, onWrap }; build(it.g, it); L.items.push(it); return it; };
  loops.push(L); return L;
}
function updateScrollers(scroll) {
  for (const t of tiles) setT(t.g, `translate(${f1(t.x0 - mod(scroll * t.f + t.drift, t.w))},0)`);
  for (const L of loops) for (const it of L.items) {
    const raw = it.x - scroll * L.f + L.margin;
    const cyc = Math.floor(raw / L.period);
    const sx = mod(raw, L.period) - L.margin;
    if (cyc !== it.cycle) { if (it.cycle !== -1 && it.onWrap) it.onWrap(it); it.cycle = cyc; }
    it.sx = sx;
    setT(it.g, `translate(${f1(sx)},0)`);
  }
}

