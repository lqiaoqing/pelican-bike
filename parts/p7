  runTasks();
  physics(dt);
  if (sanitizeState()) physics(0);
  render(dt, rdt);
  hideIdle();
  updateHUD(rdt);
}
// 初始化
rebuildChain();
setCad(S.targetCad);
refreshUI();
if (Q.get('panel') === '0') setFold(true);
if (Q.get('panel') === '1') { setFold(false); fitAspect(false); }
if (Q.get('help') === '1') $('help').classList.add('show');
if (S.labels && portrait) fitAspect(false);
if (Q.get('zoom')) { const z = +Q.get('zoom'); zoomAt(z, +(Q.get('zx') || 780), +(Q.get('zy') || 520)); }
if (Q.get('mouth') === '1') S.mouthTarget = 1;
if (Q.get('bubble')) bubble(Q.get('bubble'));
// 预热（URL 参数 warm=秒数，用于截图时直接进入稳定状态）
if (Q.get('warm')) { const n = Math.round(+Q.get('warm') * 60); for (let i = 0; i < n; i++) step(1 / 60, 1 / 60); }
// 自检（URL 参数 selftest=1）：依次触发所有交互，结果写入标题，便于无头浏览器验证
if (Q.get('selftest') === '1') {
  const log = [];
  const key = (k, up) => dispatchEvent(new KeyboardEvent(up ? 'keyup' : 'keydown', { key: k, code: k === ' ' ? 'Space' : '' }));
  try {
    ['ArrowUp', 'w', 'ArrowDown', 's', 'q', 'e', 'e', 'b', 'n', 'r', 'g', 'l', 'm', 'm', 'f', 'c', '+', '-', '0', 'h', 'h'].forEach(k => { key(k); for (let i = 0; i < 20; i++) step(1 / 60, 1 / 60); });
    key(' '); for (let i = 0; i < 90; i++) step(1 / 60, 1 / 60); key(' ', true);
    ['btnPlay', 'btnPlay', 'btnSlow', 'btnSlow', 'btnNight', 'btnRain', 'btnWind', 'btnLabels', 'btnFish', 'btnPoke', 'btnView', 'btnBell', 'gDown', 'gUp', 'btnFold', 'btnFold', 'btnHelp', 'btnHelp', 'btnSound', 'btnSound'].forEach(id => { $(id).click(); for (let i = 0; i < 15; i++) step(1 / 60, 1 / 60); });
    fishes.forEach(f => { if (f.state === 'jump') catchFish(f); });
    for (let i = 0; i < 400; i++) step(1 / 60, 1 / 60);
    pokePelican(); for (let i = 0; i < 120; i++) step(1 / 60, 1 / 60);
    log.push('OK', 'v=' + S.v.toFixed(2), 'gear=' + (S.gear + 1), 'fish=' + S.fishCaught, 'basket=' + S.basketFish, 'eaten=' + S.eaten, 'night=' + S.night, 'rain=' + S.rain, 'wind=' + S.wind);
  } catch (err) { log.push('ERR ' + err.message + ' ' + (err.stack || '').split('\n')[1]); }
  document.title = 'SELFTEST ' + log.join(' ');
}
requestAnimationFrame(frame);
</script>
</body>
</html>
